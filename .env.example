# Copia este archivo a .env y pon tus valores reales.
# NUNCA subas .env a git.

# URL del proyecto Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave publicable / anon (Project Settings -> API Keys -> "publishable").
# Es segura para el navegador: toda la protección está en las políticas RLS.
# NO uses la clave service_role / secret aquí.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx
